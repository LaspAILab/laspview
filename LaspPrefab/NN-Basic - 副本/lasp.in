potential nn
explore_type ssw
Ewaldflag    0
%block netinfo
  O CHON.pot
  H CHON.pot
  C CHON.pot
%endblock netinfo
PrintChg 0

Run_type 5    #    5  for SSW with fixed cell

SSW.SSWsteps  10     # 0 single point
                    # 1 stru opt
                    # > 1  SSW global opt


#  for SSW search  start
SSW.Temp   100
SSW.DimerdR 0.01
SSW.ds_atom 0.6
SSW.NG            9 
SSW.inirot   1
SSW.ftol         0.1
SSW.Ratio_Local       50

# output
SSW.output F
SSW.printevery F


