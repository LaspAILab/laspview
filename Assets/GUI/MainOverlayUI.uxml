    <ui:Template name="OptionsPanelUI" src="project://database/Assets/GUI/OptionsPanelUI.uxml?fileID=9197481963319205126&amp;guid=81c1a7024a0a7ff439a430fdde25a116&amp;type=3#OptionsPanelUI"/>
    <ui:Template name="ProjectPanelUI" src="project://database/Assets/GUI/ProjectPanelUI.uxml?fileID=9197481963319205126&amp;guid=c303e6b0099efa7468c5735d6cbb93ea&amp;type=3#ProjectPanelUI"/>
    <Style src="project://database/Assets/GUI/SharedStyle.uss?fileID=7433441132597879392&amp;guid=7ed00aed86adc9048905bdad1619bf4c&amp;type=3#SharedStyle"/>
    <ui:VisualElement name="TopBar" enabled="true" style="flex-grow: 1; height: 65px; background-color: rgb(255, 255, 255); position: absolute; top: 0; left: 0; right: 0; border-bottom-width: 2px; border-bottom-color: rgb(124, 124, 124); align-content: auto; flex-direction: row;">
        <ui:VisualElement enabled="true" name="Icon" focusable="false" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Icons/lasp.png?fileID=2800000&amp;guid=c5ae5a4f1fb24cf4795cdfb018ca702e&amp;type=3#lasp&quot;); height: 45px; width: 45px; align-content: auto; align-self: center; align-items: stretch; flex-direction: column; position: relative; margin-left: 20px;"/>
        <ui:Label text="LaspView" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; align-content: flex-start; height: 90%; align-self: flex-start; justify-content: flex-start; padding-left: 2px; margin-left: 12px; margin-right: 30px;"/>
        <ui:Button text="File" enable-rich-text="false" name="FileButton" class="title-button active-title-button"/>
        <ui:Button text="Project" enable-rich-text="false" name="ProjectButton" class="title-button"/>
        <ui:Button text="Options" enable-rich-text="false" name="OptionsButton" class="title-button"/>
        <ui:Button text="Edit" enable-rich-text="false" name="EditButton" class="title-button"/>
        <ui:Button text="Utils" enable-rich-text="false" name="LaspButton" class="title-button"/>
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:Label text="UI Scale" class="display-option-item" style="align-self: center; margin-right: 5px;"/>
        <ui:Button text="-" name="UIScalePlus" style="background-color: rgb(255, 255, 255); border-right-width: 0; border-top-left-radius: 10px; border-bottom-left-radius: 10px; height: 75%; align-self: center; margin-right: 0; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); padding-left: 10px; padding-right: 5px;"/>
        <ui:Button text="+" name="UIScaleMinus" style="background-color: rgb(255, 255, 255); border-right-width: 1px; border-top-left-radius: 0; border-bottom-left-radius: 0; height: 75%; align-self: center; margin-right: 4px; font-size: 20px; margin-left: 0; border-left-width: 0; border-top-right-radius: 10px; border-bottom-right-radius: 10px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); padding-left: 5px; padding-right: 10px;"/>
        <ui:Button name="AboutButton" enable-rich-text="false" class="title-button" style="background-image: url(&quot;project://database/Assets/Icons/info.png?fileID=2800000&amp;guid=37a2f2f05462b0f479c320e86d563407&amp;type=3#info&quot;); width: 45px; height: 45px; background-size: 80% 80%; margin-left: 15px; padding-left: 10px; padding-right: 10px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="BottomBar" style="flex-grow: 1; position: absolute; left: 0; right: 0; bottom: 0; height: 65px; background-color: rgb(255, 255, 255); border-top-width: 2px; border-top-color: rgb(124, 124, 124); flex-direction: row; justify-content: space-between;">
        <ui:VisualElement name="StructureIndexDisplay" style="flex-grow: 0; height: 75%; align-self: center; flex-direction: row;">
            <ui:Label text="Structure: " style="font-size: 24px; -unity-text-align: middle-left; margin-left: 30px; margin-right: 10px;"/>
            <ui:SliderInt value="42" high-value="100" show-input-field="false" fill="true" style="width: 12%; margin-right: 20px; display: none;"/>
            <ui:Button text="-" name="StructureMinus" style="background-color: rgb(255, 255, 255); border-right-width: 0; border-top-left-radius: 10px; border-bottom-left-radius: 10px; height: 100%; align-self: center; margin-right: 0; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); padding-left: 10px; padding-right: 5px;"/>
            <ui:IntegerField value="0" name="CurrentStructure" style="margin-left: 0; margin-right: 0; height: 100%; align-self: center; font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceNeon-Regular.otf?fileID=12800000&amp;guid=704252a8f5598034bbfea1b73f33f211&amp;type=3#MonaspaceNeon-Regular&quot;);"/>
            <ui:Button text="+" name="StructurePlus" style="background-color: rgb(255, 255, 255); border-right-width: 1px; border-top-left-radius: 0; border-bottom-left-radius: 0; height: 100%; align-self: center; margin-right: 4px; font-size: 20px; margin-left: 0; border-left-width: 0; border-top-right-radius: 10px; border-bottom-right-radius: 10px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); padding-left: 5px; padding-right: 10px;"/>
            <ui:Label text="of 0" name="TotalStructures" enable-rich-text="false" style="align-content: flex-start; align-self: center; font-size: 20px; margin-left: 5px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceNeon-Regular.otf?fileID=12800000&amp;guid=704252a8f5598034bbfea1b73f33f211&amp;type=3#MonaspaceNeon-Regular&quot;);"/>
            <ui:Button name="CopyAppendButton" text="Copy and append" class="icon-button" style="width: auto; height: 100%; border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 15px; margin-right: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px; align-self: center; font-size: 16px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="AnimationPlayDisplay" style="flex-grow: 0; align-self: center; flex-direction: row; left: 80px;">
            <ui:Button name="FirstButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/player_head.png?fileID=2800000&amp;guid=550ef0b891b12344fb5ec004d6466080&amp;type=3#player_head&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px;"/>
            <ui:Button name="PreviousButton" selectable="false" enabled="true" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/player_back.png?fileID=2800000&amp;guid=02fe9449c01aaf641bfbc48dbb29c9e7&amp;type=3#player_back&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0; visibility: visible;"/>
            <ui:Button name="PlayButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/player_play.png?fileID=2800000&amp;guid=671b1c446ad637346a2450110b7327fa&amp;type=3#player_play&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0;"/>
            <ui:Button name="PauseButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/player_pause.png?fileID=2800000&amp;guid=46289f92d238d0a488094825e18f9cb6&amp;type=3#player_pause&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0;"/>
            <ui:Button name="NextButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/player_forward.png?fileID=2800000&amp;guid=d8ed1099b5b37124496521ab75b21729&amp;type=3#player_forward&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0;"/>
            <ui:Button name="LastButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/player_tail.png?fileID=2800000&amp;guid=9f0a72b0756525944adb00a9ac5b5984&amp;type=3#player_tail&quot;); border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 0; margin-right: 0;"/>
            <ui:Button name="FocusButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/center.png?fileID=2800000&amp;guid=6123d8f7c6db02645a72ccdbdb39e5cd&amp;type=3#center&quot;); border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 40px; margin-right: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px;"/>
            <ui:Button name="FocusSelectedButton" text="Sel" triple-click-selects-line="false" double-click-selects-word="false" class="icon-button" style="width: 75px; height: 45px; background-image: url(&quot;project://database/Assets/Icons/center.png?fileID=2800000&amp;guid=6123d8f7c6db02645a72ccdbdb39e5cd&amp;type=3#center&quot;); border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 5px; margin-right: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px; background-size: 45% 75%; background-position-x: left 8px; -unity-font-style: italic; color: rgb(0, 0, 0); -unity-text-align: middle-right; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); padding-right: 8px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="LogDisplay" style="flex-grow: 0; align-self: center; flex-direction: row-reverse; width: 40%;">
            <ui:Button text="Idle. " enable-rich-text="false" name="StatusLabel" picking-mode="Ignore" class="transparent-button" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); text-overflow: ellipsis; width: auto; -unity-text-align: middle-right;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="FilePanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: 0; width: 300px; display: flex;">
        <ui:Instance template="FilePanelUI"/>
    </ui:VisualElement>
    <ui:VisualElement name="ProjectPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: 0; width: 350px; display: none;">
        <ui:Instance template="ProjectPanelUI"/>
    </ui:VisualElement>
    <ui:VisualElement name="OptionsPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: 0; width: 450px; display: none;">
        <ui:Instance template="OptionsPanelUI"/>
    </ui:VisualElement>
    <ui:VisualElement name="GizmoPanel" style="flex-grow: 1; left: 0; width: 150px; height: 150px; bottom: 65px; position: absolute;"/>
    <ui:VisualElement enabled="true" name="AboutPanel" style="position: absolute; flex-grow: 1; justify-content: center; top: 0; bottom: 0; right: 0; left: 0; display: none;">
        <ui:Instance template="AboutPanel" style="width: 40%; align-self: center; height: auto; max-height: 80%;"/>
    </ui:VisualElement>
    <ui:VisualElement name="EditPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: auto; width: 450px; display: none; right: 0;">
        <ui:Instance template="EditPanelUI" style="display: flex;"/>
    </ui:VisualElement>
    <ui:VisualElement name="LeftInfoPanel" picking-mode="Ignore" class="transparent-panel" style="flex-grow: 1; left: 150px; margin-left: 0; max-width: 400px; bottom: 70px; display: none;">
        <ui:Label text="Selected: 0" name="SelectionLabel" picking-mode="Ignore" class="info-label" style="white-space: normal;"/>
        <ui:Label name="AdditionalInfoLabel" picking-mode="Ignore" class="info-label" style="white-space: normal;"/>
    </ui:VisualElement>
    <ui:VisualElement name="RightInfoPanel" picking-mode="Ignore" class="transparent-panel" style="flex-grow: 1; left: auto; margin-left: 0; max-width: 400px; right: 20px; bottom: 70px;">
        <ui:Label text="Energy: 0" name="EnergyLabel" picking-mode="Ignore" class="info-label"/>
        <ui:Label text="Atom count: 0" name="AtomCountLabel" picking-mode="Ignore" class="info-label" style="white-space: normal;"/>
    </ui:VisualElement>
    <ui:VisualElement name="LaspPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: auto; width: 450px; display: none; right: 0;">
        <ui:Instance template="LaspPanelUI"/>
    </ui:VisualElement>
    <ui:VisualElement name="PopupWindowPanel" style="width: 100%; height: 100%; justify-content: center; display: none;">
        <ui:VisualElement name="PopupWindowContainer" style="flex-grow: 0; justify-content: center; max-width: 50%; max-height: 50%; align-self: center; min-width: 20%; background-color: rgb(255, 255, 255); margin-bottom: 0; padding-bottom: 10px; padding-left: 5px; padding-right: 5px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(122, 122, 122); border-right-color: rgb(122, 122, 122); border-top-color: rgb(122, 122, 122); border-bottom-color: rgb(122, 122, 122);">
            <ui:VisualElement name="" style="flex-grow: 0; flex-direction: row; padding-left: 10px; padding-right: 5px; border-bottom-width: 2px; border-bottom-color: rgb(179, 179, 179); flex-shrink: 0; margin-bottom: 5px;">
                <ui:Label text="Popup window" name="PopupWindowTitle" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Bold.otf?fileID=12800000&amp;guid=39d04e98a75588e41b389a6c49179526&amp;type=3#MonaspaceArgon-Bold&quot;); align-self: center;"/>
                <ui:VisualElement style="flex-grow: 1;"/>
                <ui:Button name="ClosePopupButton" class="transparent-button" style="width: 30px; height: 30px; padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/Icons/cancel.png?fileID=2800000&amp;guid=a794ba63a6b8ae348ae1e6dde13c8000&amp;type=3#cancel&quot;); background-size: 80% 80%; border-top-right-radius: 5px; flex-grow: 0;"/>
            </ui:VisualElement>
            <ui:Instance template="ChangeLatticeUI" style="flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
