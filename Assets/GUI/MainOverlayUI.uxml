<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="FilePanelUI" src="project://database/Assets/GUI/FilePanelUI.uxml?fileID=9197481963319205126&amp;guid=a6aa85b456256004db58338ce3897a87&amp;type=3#FilePanelUI" />
    <ui:Template name="ProjectPanelUI" src="project://database/Assets/GUI/ProjectPanelUI.uxml?fileID=9197481963319205126&amp;guid=c303e6b0099efa7468c5735d6cbb93ea&amp;type=3#ProjectPanelUI" />
    <ui:Template name="OptionsPanelUI" src="project://database/Assets/GUI/OptionsPanelUI.uxml?fileID=9197481963319205126&amp;guid=81c1a7024a0a7ff439a430fdde25a116&amp;type=3#OptionsPanelUI" />
    <ui:Template name="AboutPanel" src="project://database/Assets/GUI/AboutPanel.uxml?fileID=9197481963319205126&amp;guid=ccaab4f1a06a39646963ad35f6a1d4b7&amp;type=3#AboutPanel" />
    <ui:Template name="EditPanelUI" src="project://database/Assets/GUI/EditPanelUI.uxml?fileID=9197481963319205126&amp;guid=07866727b8be997458cf7c44dea24471&amp;type=3#EditPanelUI" />
    <ui:Template name="PeriodicTableControl" src="project://database/Assets/GUI/PeriodicTableControl/PeriodicTableControl.uxml?fileID=9197481963319205126&amp;guid=06bb632aa38eace4ea9f72de01e8d669&amp;type=3#PeriodicTableControl" />
    <Style src="project://database/Assets/GUI/SharedStyle.uss?fileID=7433441132597879392&amp;guid=7ed00aed86adc9048905bdad1619bf4c&amp;type=3#SharedStyle" />
    <ui:VisualElement name="TopBar" enabled="true" style="flex-grow: 1; height: 65px; background-color: rgb(255, 255, 255); position: absolute; top: 0; left: 0; right: 0; border-bottom-width: 2px; border-bottom-color: rgb(124, 124, 124); align-content: auto; flex-direction: row;">
        <ui:VisualElement enabled="true" name="Icon" focusable="false" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GUIIcon/lasp%20(2).png?fileID=2800000&amp;guid=c5ae5a4f1fb24cf4795cdfb018ca702e&amp;type=3#lasp (2)&quot;); height: 45px; width: 45px; align-content: auto; align-self: center; align-items: stretch; flex-direction: column; position: relative; margin-left: 20px;" />
        <ui:Label text="LaspView" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; align-content: flex-start; height: 90%; align-self: flex-start; justify-content: flex-start; padding-left: 2px; margin-left: 12px; margin-right: 30px;" />
        <ui:Button text="File" enable-rich-text="false" name="FileButton" class="title-button active-title-button" />
        <ui:Button text="Project&#10;" enable-rich-text="false" name="ProjectButton" class="title-button" />
        <ui:Button text="Options" enable-rich-text="false" name="OptionsButton" class="title-button" />
        <ui:Button text="Edit" enable-rich-text="false" name="EditButton" class="title-button" />
        <ui:VisualElement style="flex-grow: 1;" />
        <ui:Button name="AboutButton" enable-rich-text="false" class="title-button" style="background-image: url(&quot;project://database/Assets/GUIIcon/info.png?fileID=2800000&amp;guid=37a2f2f05462b0f479c320e86d563407&amp;type=3#info&quot;); width: 45px; height: 45px; background-size: 80% 80%; margin-left: 0; padding-left: 10px; padding-right: 10px;" />
    </ui:VisualElement>
    <ui:VisualElement name="BottomBar" style="flex-grow: 1; position: absolute; left: 0; right: 0; bottom: 0; height: 65px; background-color: rgb(255, 255, 255); border-top-width: 2px; border-top-color: rgb(124, 124, 124); flex-direction: row; justify-content: space-between;">
        <ui:VisualElement name="StructureIndexDisplay" style="flex-grow: 0; height: 75%; align-self: center; flex-direction: row;">
            <ui:Label text="Structure: " style="font-size: 24px; -unity-text-align: middle-left; margin-left: 30px; margin-right: 10px;" />
            <ui:SliderInt value="42" high-value="100" show-input-field="false" fill="true" style="width: 12%; margin-right: 20px; display: none;" />
            <ui:Button text="-&#10;" name="StructureMinus" style="background-color: rgb(255, 255, 255); border-right-width: 0; border-top-left-radius: 10px; border-bottom-left-radius: 10px; height: 100%; align-self: center; margin-right: 0; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); padding-left: 10px; padding-right: 5px;" />
            <ui:IntegerField value="3" name="CurrentStructure" style="margin-left: 0; margin-right: 0; height: 100%; align-self: center; font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceNeon-Regular.otf?fileID=12800000&amp;guid=704252a8f5598034bbfea1b73f33f211&amp;type=3#MonaspaceNeon-Regular&quot;);" />
            <ui:Button text="+" name="StructurePlus" style="background-color: rgb(255, 255, 255); border-right-width: 1px; border-top-left-radius: 0; border-bottom-left-radius: 0; height: 100%; align-self: center; margin-right: 4px; font-size: 20px; margin-left: 0; border-left-width: 0; border-top-right-radius: 10px; border-bottom-right-radius: 10px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); padding-left: 5px; padding-right: 10px;" />
            <ui:Label text="of 5" name="TotalStructures" style="align-content: flex-start; align-self: center; font-size: 20px; margin-left: 5px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceNeon-Regular.otf?fileID=12800000&amp;guid=704252a8f5598034bbfea1b73f33f211&amp;type=3#MonaspaceNeon-Regular&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="AnimationPlayDisplay" style="flex-grow: 0; align-self: center; flex-direction: row; left: 80px;">
            <ui:Button name="FirstButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/player_head.png?fileID=2800000&amp;guid=550ef0b891b12344fb5ec004d6466080&amp;type=3#player_head&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px;" />
            <ui:Button name="PreviousButton" selectable="false" enabled="true" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/player_back.png?fileID=2800000&amp;guid=02fe9449c01aaf641bfbc48dbb29c9e7&amp;type=3#player_back&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0; visibility: visible;" />
            <ui:Button name="PlayButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/player_play.png?fileID=2800000&amp;guid=671b1c446ad637346a2450110b7327fa&amp;type=3#player_play&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0;" />
            <ui:Button name="PauseButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/player_pause.png?fileID=2800000&amp;guid=46289f92d238d0a488094825e18f9cb6&amp;type=3#player_pause&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0;" />
            <ui:Button name="NextButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/player_forward.png?fileID=2800000&amp;guid=d8ed1099b5b37124496521ab75b21729&amp;type=3#player_forward&quot;); border-top-right-radius: 0; border-bottom-right-radius: 0; margin-left: 0; margin-right: 0;" />
            <ui:Button name="LastButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/player_tail.png?fileID=2800000&amp;guid=9f0a72b0756525944adb00a9ac5b5984&amp;type=3#player_tail&quot;); border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 0; margin-right: 0;" />
            <ui:Button name="FocusButton" class="icon-button" style="width: 45px; height: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/center.png?fileID=2800000&amp;guid=6123d8f7c6db02645a72ccdbdb39e5cd&amp;type=3#center&quot;); border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 40px; margin-right: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px;" />
        </ui:VisualElement>
        <ui:VisualElement name="LogDisplay" style="flex-grow: 0; align-self: center; flex-direction: row-reverse;">
            <ui:Button enable-rich-text="false" name="Button" class="transparent-button" style="width: 45px; background-image: url(&quot;project://database/Assets/GUIIcon/terminal.png?fileID=2800000&amp;guid=e683a2af25e470f40b0c47b772121ca0&amp;type=3#terminal&quot;); background-size: 80% 80%; height: 45px; margin-right: 10px;" />
            <ui:Button text="Just finished loading file xxxxxxxxxxxxbbbbbbb" enable-rich-text="false" name="StatusLabel" class="transparent-button" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&amp;guid=cd56282d3b0ad7b4aba00251bfaf2e0a&amp;type=3#MonaspaceArgon-Regular&quot;); text-overflow: ellipsis; width: 500px; -unity-text-align: middle-left;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="LeftInfoPanel" picking-mode="Ignore" class="transparent-panel" style="flex-grow: 1; left: 150px; margin-left: 0; max-width: 400px;">
        <ui:Label text="Energy: 5.7" name="EnergyLabel" picking-mode="Ignore" class="info-label" />
        <ui:Label text="Atom count: 118" name="AtomCountLabel" picking-mode="Ignore" class="info-label" style="white-space: normal;" />
        <ui:Label text="Selected: 0" name="SelectionLabel" picking-mode="Ignore" class="info-label" style="white-space: normal;" />
        <ui:Label name="AdditionalInfoLabel" picking-mode="Ignore" class="info-label" style="white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="FilePanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: 0; width: 250px; display: flex;">
        <ui:Instance template="FilePanelUI" />
    </ui:VisualElement>
    <ui:VisualElement name="ProjectPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: 0; width: 350px; display: none;">
        <ui:Instance template="ProjectPanelUI" />
    </ui:VisualElement>
    <ui:VisualElement name="OptionsPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: 0; width: 450px; display: none;">
        <ui:Instance template="OptionsPanelUI" />
    </ui:VisualElement>
    <ui:VisualElement name="GizmoPanel" style="flex-grow: 1; left: 0; width: 150px; height: 150px; bottom: 65px; position: absolute;" />
    <ui:VisualElement picking-mode="Ignore" enabled="true" style="position: absolute; flex-grow: 1; justify-content: center; width: auto; height: auto; top: 0; bottom: 0; left: 0; right: 0;">
        <ui:VisualElement name="CenterPanel" picking-mode="Ignore" class="center-panel-pan" style="flex-grow: 0; width: 320px; height: 320px; align-self: center; background-color: rgba(185, 185, 185, 0.48); border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px; display: flex; transition-duration: 0.15s; opacity: 0; transition-property: opacity;" />
    </ui:VisualElement>
    <ui:VisualElement enabled="true" name="AboutPanel" style="position: absolute; flex-grow: 1; justify-content: center; top: 0; bottom: 0; right: 0; left: 0; display: none;">
        <ui:Instance template="AboutPanel" style="width: 30%; align-self: center; height: auto; max-height: 60%;" />
    </ui:VisualElement>
    <ui:VisualElement name="EditPanel" class="round-panel" style="flex-grow: 1; position: absolute; top: 65px; left: auto; width: 450px; display: none; right: 0;">
        <ui:Instance template="EditPanelUI" />
    </ui:VisualElement>
    <ui:VisualElement enabled="true" name="PeriodicTablePanel" style="position: absolute; flex-grow: 1; justify-content: center; width: auto; height: auto; top: 0; bottom: 0; left: 0; right: 0; align-items: center; display: none;">
        <ui:VisualElement class="window-frame" style="flex-grow: 0; padding-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px;">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; padding-left: 10px; padding-right: 5px; border-bottom-width: 2px; border-bottom-color: rgb(179, 179, 179); flex-shrink: 0; margin-bottom: 5px;">
                <ui:Label text="Periodic table picker" style="font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Bold.otf?fileID=12800000&amp;guid=39d04e98a75588e41b389a6c49179526&amp;type=3#MonaspaceArgon-Bold&quot;); align-self: center;" />
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Button name="ExitPeriodicButton" class="transparent-button" style="width: 30px; height: 30px; padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/GUIIcon/cancel.png?fileID=2800000&amp;guid=a794ba63a6b8ae348ae1e6dde13c8000&amp;type=3#cancel&quot;); background-size: 80% 80%; border-top-right-radius: 5px;" />
            </ui:VisualElement>
            <ui:Instance template="PeriodicTableControl" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
