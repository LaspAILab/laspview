    <ui:Label text="Active Project Files" style="font-size: 22px; margin-left: 12px; padding-top: 8px; padding-bottom: 2px; -unity-font-style: bold; padding-left: 4px; margin-bottom: 0;"/>
    <ui:Label text="To save memory, only the last 3 files will be kept. Remember to &lt;b&gt;save&lt;/b&gt; your changes in case your edited files are discarded. " name="MemoryNoticeLabel" style="font-size: 16px; margin-left: 12px; padding-top: 0; padding-bottom: 0; -unity-font-style: normal; padding-left: 4px; white-space: normal; margin-top: 0; margin-bottom: 4px; display: none;"/>
    <ui:ScrollView horizontal-scroller-visibility="Auto" mode="VerticalAndHorizontal" class="no-wrap-scroll-view" style="max-height: 400px; overflow: visible; flex-wrap: nowrap; flex-grow: 0; flex-direction: column;">
        <ui:Button text="A Very long name loooooooog" name="SampleItem" class="transparent-button project-item-button" style="background-position-x: left 20px; background-size: 20px 20px; min-width: auto; height: 35px; padding-top: 5px; padding-bottom: 5px; display: none;"/>
    </ui:ScrollView>
