<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GUI/SharedStyle.uss?fileID=7433441132597879392&amp;guid=7ed00aed86adc9048905bdad1619bf4c&amp;type=3#SharedStyle" />
    <ui:Label text="Display Options" enable-rich-text="false" style="font-size: 22px; margin-left: 12px; padding-top: 8px; padding-bottom: 8px; -unity-font-style: bold; padding-left: 4px; border-bottom-width: 1px; border-bottom-color: rgb(122, 122, 122);" />
    <ui:ScrollView horizontal-scroller-visibility="Hidden" style="max-height: 500px;">
        <ui:Label text="Misc" enable-rich-text="false" class="display-option-subtitle" />
        <ui:EnumField label="Background" type="BackgroundColorType, Assembly-CSharp" name="BackgroundColor" class="display-option-item">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="DisplayStyle" binding-mode="ToSource" />
            </Bindings>
        </ui:EnumField>
        <ui:Slider label="Play interval" value="0.1" high-value="1" show-input-field="true" name="PlayInterval" class="display-option-item" />
        <ui:Label text="Lattice" enable-rich-text="false" enabled="true" class="display-option-subtitle" />
        <ui:Toggle label="Show lattice" name="ShowLattice" value="true" class="display-option-item" style="justify-content: flex-start; align-content: auto; align-items: stretch;" />
        <ui:SliderInt label="Lat range a" value="1" high-value="3" show-input-field="true" low-value="1" name="LatRangeA" class="display-option-item" />
        <ui:SliderInt label="Lat range b" value="1" high-value="3" show-input-field="true" low-value="1" name="LatRangeB" class="display-option-item" />
        <ui:SliderInt label="Lat range c" value="1" high-value="3" show-input-field="true" low-value="1" name="LatRangeC" class="display-option-item" />
        <ui:Slider label="Line width" value="0.05" high-value="0.2" show-input-field="true" name="LineWidth" low-value="0.01" class="display-option-item" />
        <ui:Label text="Atoms and bonds display" enable-rich-text="false" class="display-option-subtitle" />
        <ui:EnumField label="Display style" type="DisplayStyleType, Assembly-CSharp" name="DisplayStyle" class="display-option-item">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="DisplayStyle" binding-mode="ToSource" />
            </Bindings>
        </ui:EnumField>
        <ui:Slider label="Ball radius" value="1" high-value="2.5" show-input-field="true" name="BallRadius" class="display-option-item" />
        <ui:Slider label="Stick radius" value="0.35" high-value="2" show-input-field="true" name="StickRadius" class="display-option-item" />
        <ui:Toggle label="Show highlight" name="ShowHighlight" value="true" class="display-option-item" style="justify-content: flex-start; align-content: auto; align-items: stretch;" />
        <ui:Label text="Bond calculation" enable-rich-text="false" class="display-option-subtitle" />
        <ui:Toggle label="Show H bonds" name="ShowHBonds" value="true" class="display-option-item" style="justify-content: flex-start; align-content: auto; align-items: stretch;" />
        <ui:Slider label="Bond tolerance" value="1.26" high-value="3" show-input-field="true" name="BondTolerance" class="display-option-item" />
        <ui:EnumField label="Cross-cell calculation" value="Adjacent" type="CrossCellBondPolicy, Assembly-CSharp" name="BondPolicy" class="display-option-item">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="BondPolicy" binding-mode="ToSource" />
            </Bindings>
        </ui:EnumField>
    </ui:ScrollView>
</ui:UXML>
