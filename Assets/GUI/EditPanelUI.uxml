<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GUI/SharedStyle.uss?fileID=7433441132597879392&amp;guid=7ed00aed86adc9048905bdad1619bf4c&amp;type=3#SharedStyle" />
    <Style src="project://database/Assets/GUI/Vec3Input/Vec3Input.uss?fileID=7433441132597879392&amp;guid=bad3aff1201eb954091907dee4fa65ca&amp;type=3#Vec3Input" />
    <ui:VisualElement style="flex-grow: 1; margin-top: 5px; margin-bottom: 10px;">
        <ui:Label text="Lattice" class="display-option-subtitle" />
        <Vec3InputControl text="Lengths" name="LatticeLengthsInput" class="edit-panel-item" />
        <Vec3InputControl text="Angles" name="LatticeAnglesInput" class="edit-panel-item" />
        <ui:Toggle label="Keep fractional coords" name="KeepFractionalToggle" class="edit-panel-item" />
        <ui:Button text="Change lattice" name="ChangeLatticeButton" class="edit-panel-button edit-panel-item" />
        <Vec3InputControl text="Repeats" value="1,1,1" name="RepeatsInput" class="edit-panel-item" />
        <ui:Button text="Generate supercell" name="SupercellButton" class="edit-panel-button edit-panel-item" />
        <ui:Label text="Atom" class="display-option-subtitle" />
        <ui:Label text="Multiple atoms selected, atom property editor disabled." enable-rich-text="false" name="MultiselectLabel" class="edit-panel-item" style="white-space: normal; visibility: visible; display: none;" />
        <ui:VisualElement name="ElementRow" class="edit-panel-item" style="flex-grow: 0; flex-direction: row;">
            <ui:TextField label="Element" name="ElementInput" value="H" readonly="true" style="flex-grow: 1;" />
            <ui:Button text="Replace" name="ReplaceElementButton" enable-rich-text="false" class="edit-panel-button" style="height: auto; flex-grow: 0;" />
        </ui:VisualElement>
        <ui:Toggle label="Fractional coords" name="FractionalToggle" class="edit-panel-item" />
        <Vec3InputControl text="Coordinates" value="0,0,0" name="CoordsInput" class="edit-panel-item" />
        <ui:Button text="Add atom" name="AddAtomButton" class="edit-panel-button edit-panel-item" />
        <ui:FloatField label="Display radius" value="42.2" name="DisplayRadiusInput" class="edit-panel-item" style="display: none;" />
        <ui:TextField label="Display color" placeholder-text="H" name="DisplayColorInput" class="edit-panel-item" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
