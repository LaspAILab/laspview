<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GUI/SharedStyle.uss?fileID=7433441132597879392&amp;guid=7ed00aed86adc9048905bdad1619bf4c&amp;type=3#SharedStyle" />
    <ui:VisualElement class="window-frame">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; padding-left: 10px; padding-right: 5px; border-bottom-width: 2px; border-bottom-color: rgb(179, 179, 179); flex-shrink: 0;">
            <ui:Label text="About" style="font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceArgon-Bold.otf?fileID=12800000&amp;guid=39d04e98a75588e41b389a6c49179526&amp;type=3#MonaspaceArgon-Bold&quot;); align-self: center;" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:Button name="ExitAboutButton" class="transparent-button" style="width: 30px; height: 30px; padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/GUIIcon/cancel.png?fileID=2800000&amp;guid=a794ba63a6b8ae348ae1e6dde13c8000&amp;type=3#cancel&quot;); background-size: 80% 80%; border-top-right-radius: 5px;" />
        </ui:VisualElement>
        <ui:Label text="&lt;i&gt;&lt;b&gt;LaspView&lt;/b&gt;&lt;/i&gt; version %v" class="about-text" style="margin-top: 6px;" />
        <ui:Label text="A visualization software created for LASP by Liu Group@Fudan. " class="about-text" style="white-space: normal;" />
        <ui:Label text="LASP Website: &lt;a href=&quot;https://laspai.com/&quot;&gt;&lt;u&gt;https://laspai.com&lt;/u&gt;&lt;/a&gt;" class="about-text" style="white-space: normal;" />
        <ui:Label text="Running on OS: %os" class="about-text" />
        <ui:Label text="This is a completely recreated version by &lt;i&gt;Y.C. Xu&lt;/i&gt; (&lt;a href=&quot;https://github.com/HydrogenC&quot;&gt;&lt;u&gt;@HydrogenC&lt;/u&gt;&lt;/a&gt;), superseding the classical version by &lt;i&gt;Y.F. Shi&lt;/i&gt; (&lt;a href=&quot;https://github.com/paptigshiyf&quot;&gt;&lt;u&gt;@paptigshiyf&lt;/u&gt;&lt;/a&gt;)." class="about-text" style="white-space: normal; font-size: 14px; -unity-font-definition: url(&quot;project://database/Assets/GUI/Fonts/MonaspaceNeon-Light.otf?fileID=12800000&amp;guid=009d887e466418f449399db5ab5b1703&amp;type=3#MonaspaceNeon-Light&quot;);" />
        <ui:ScrollView horizontal-scroller-visibility="Hidden" style="max-height: 400px; margin-top: 5px; flex-grow: 1;">
            <ui:TextField readonly="true" multiline="true" value="Tutorial:&#10;-- Viewport operations&#10;1. Drag with left mouse button to rotate view&#10;2. Drag with middle mouse button to move view&#10;&#10;-- Selection&#10;1. Click with right mouse button to select single atom&#10;2. Shift + Right mouse button to append/remove from selection&#10;2. Drag with right mouse button to box select&#10;3. Click on empty screen with right mouse button to clear selection&#10;&#10;-- Atom operations&#10;1. Alt + Right mouse button to move selected atoms&#10;2. Alt + Left mouse button to rotate selected atoms&#10;&#10;-- Hotkeys (all Ctrl are replaced with Command on Mac machines)&#10;1. Ctrl + C to copy selected atoms&#10;2. Ctrl + V to paste copied atoms&#10;3. Ctrl + Z to undo last operation&#10;4. Ctrl + Y to redo undone operation&#10;" vertical-scroller-visibility="Hidden" emoji-fallback-support="false" style="font-size: 16px;" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
