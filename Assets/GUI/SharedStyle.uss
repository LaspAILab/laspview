:root {
}

.title-button {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(216, 220, 229);
    border-left-color: rgb(216, 220, 229);
    border-right-color: rgb(216, 220, 229);
    border-bottom-color: rgb(216, 220, 229);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 70%;
    align-self: center;
    background-color: rgb(255, 255, 255);
    font-size: 22px;
    padding-left: 25px;
    padding-right: 25px;
    align-content: flex-start;
    margin-left: 10px;
    margin-right: 10px;
    width: 150px;
    align-items: stretch;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    transition-duration: 0.2s;
    transition-timing-function: ease;
}

.title-button:hover {
    -unity-font-style: normal;
    border-left-color: rgb(97, 59, 231);
    border-right-color: rgb(97, 59, 231);
    border-top-color: rgb(97, 59, 231);
    border-bottom-color: rgb(97, 59, 231);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.active-title-button {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(216, 220, 229);
    border-left-color: rgb(216, 220, 229);
    border-right-color: rgb(216, 220, 229);
    border-bottom-color: rgb(216, 220, 229);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    height: 70%;
    align-self: center;
    background-color: rgb(97, 59, 231);
    color: rgb(255, 255, 255);
}

.icon-button {
    background-size: 75% 75%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 124, 124);
    border-right-color: rgb(124, 124, 124);
    border-top-color: rgb(124, 124, 124);
    border-bottom-color: rgb(124, 124, 124);
    background-color: rgb(255, 255, 255);
}

.icon-button:hover {
    background-size: 75% 75%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 124, 124);
    border-right-color: rgb(124, 124, 124);
    border-top-color: rgb(124, 124, 124);
    border-bottom-color: rgb(124, 124, 124);
    background-color: rgb(217, 217, 217);
}

.icon-button:active {
    background-size: 75% 75%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 124, 124);
    border-right-color: rgb(124, 124, 124);
    border-top-color: rgb(124, 124, 124);
    border-bottom-color: rgb(124, 124, 124);
    background-color: rgb(171, 171, 171);
}

.transparent-button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.transparent-button:hover {
    background-color: rgba(146, 146, 146, 0.33);
}

.transparent-button:active {
    background-color: rgba(146, 146, 146, 0.67);
}

.transparent-panel {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgba(171, 171, 171, 0.42);
    position: absolute;
    bottom: 65px;
    margin-left: 10px;
    margin-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.file-button {
    font-size: 20px;
    -unity-text-align: middle-left;
    background-size: 30px 30px;
    background-position-x: left 30px;
    -unity-background-scale-mode: scale-to-fit;
    padding-left: 75px;
}

.project-item-button {
    font-size: 20px;
    -unity-text-align: middle-left;
    background-size: 30px 30px;
    background-position-x: left 30px;
    -unity-background-scale-mode: scale-to-fit;
    padding-left: 60px;
    background-image: url("project://database/Assets/GUIIcon/crystal-meth.png?fileID=2800000&guid=64de2a303f7858046a31ce68904507c5&type=3#crystal-meth");
    -unity-font-definition: url("project://database/Assets/GUI/Fonts/MonaspaceArgon-Regular.otf?fileID=12800000&guid=cd56282d3b0ad7b4aba00251bfaf2e0a&type=3#MonaspaceArgon-Regular");
    border-top-width: 1px;
    border-bottom-width: 0;
    border-left-color: rgb(175, 175, 175);
    border-right-color: rgb(175, 175, 175);
    border-top-color: rgb(175, 175, 175);
    border-bottom-color: rgb(175, 175, 175);
    height: 35px;
}

.round-panel {
    background-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(97, 59, 231);
    border-right-color: rgb(97, 59, 231);
    border-top-color: rgb(97, 59, 231);
    border-bottom-color: rgb(97, 59, 231);
}

.display-option-item {
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    margin-left: 15px;
    margin-right: 15px;
}

.display-option-subtitle {
    border-left-width: 2px;
    margin-left: 15px;
    padding-left: 10px;
    font-size: 16px;
    -unity-font-style: bold;
    border-left-color: rgb(97, 59, 231);
    border-right-color: rgb(97, 59, 231);
    border-top-color: rgb(97, 59, 231);
    border-bottom-color: rgb(97, 59, 231);
}

.info-label {
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/GUI/Fonts/MonaspaceXenon-Bold.otf?fileID=12800000&guid=b08c99acbf06dda46897111737ad9b35&type=3#MonaspaceXenon-Bold");
    color: rgb(255, 255, 255);
    margin-top: 1px;
    margin-bottom: 1px;
    padding-bottom: 1px;
    padding-top: 1px;
}

.center-panel-pan {
    background-image: url("project://database/Assets/GUIIcon/pan.png?fileID=2800000&guid=d4c0a399cf9ef7846adc018c38e7393b&type=3#pan");
    background-size: 80% 80%;
}

.center-panel-rotate {
    background-image: url("project://database/Assets/GUIIcon/rotate.png?fileID=2800000&guid=e4da5028e0216c649930f6e41376bf1d&type=3#rotate");
    background-size: 60% 60%;
}

.edit-panel-item {
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    margin: 2px 15px;
}

.edit-panel-button {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(97, 59, 231);
    border-right-color: rgb(97, 59, 231);
    border-top-color: rgb(97, 59, 231);
    border-bottom-color: rgb(97, 59, 231);
    font-size: 18px;
}

.edit-panel-button:hover {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.edit-panel-button:active {
    background-color: rgb(185, 172, 231);
}

.active-edit-panel-button {
    background-color: rgb(97, 59, 231);
    color: rgb(255, 255, 255);
}

.edit-panel-item #unity-text-input {
    font-size: 16px;
}

Toggle VisualElement {
    flex-direction: row-reverse;
}

.about-text {
    margin-left: 12px;
    -unity-font-definition: url("project://database/Assets/GUI/Fonts/MonaspaceXenon-Regular.otf?fileID=12800000&guid=4e588fc7926b03e439a80f6992b0c919&type=3#MonaspaceXenon-Regular");
    margin-top: 2px;
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
    font-size: 16px;
}

.window-frame {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}
